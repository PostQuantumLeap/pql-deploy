# Post Quantum Leap — deployment configuration
#
#   cp .env.example .env      then fill in the four REQUIRED values below.
#
# Every value here is read by docker-compose.yml. A variable this file does not
# list is not necessarily settable: compose passes only the names it lists, so
# inventing one here has no effect. If you need a knob that is not below, say so
# rather than adding it — it needs a line in docker-compose.yml to reach the app.
#
# Do not commit the .env you create from this. It holds every credential the
# installation has.
#
# YOUR LICENCE DOES NOT GO IN THIS FILE. It is pasted into the application at first
# login, and it has to be ordered before you get that far -- see section 0 of the
# README. There is no licence variable here and adding one does nothing.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the instance will not start until all four are set
# ─────────────────────────────────────────────────────────────────────────────

# Database password for the owner role, which runs migrations.
#   openssl rand -base64 36
POSTGRES_PASSWORD=CHANGEME

# Signs session cookies. Must be at least 32 characters. The app refuses to
# boot on a short or default value outside development, deliberately.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=CHANGEME

# Password for the first System Administrator. At least 10 characters, and you
# are forced to change it at first login.
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
INITIAL_ADMIN_PASSWORD=CHANGEME

# Fernet key encrypting the stored SSO client secret at rest. Must be a real
# Fernet key — URL-safe base64 of exactly 32 random bytes (44 characters); a
# random string of another shape will not decode. Either command makes one and
# needs nothing beyond a stock Python or OpenSSL:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   openssl rand -base64 32 | tr '+/' '-_'
#
# Losing this key makes an already-stored SSO secret unrecoverable; it is a
# backup target in its own right. Rotating it means re-entering that secret.
SETTINGS_ENC_KEY=CHANGEME


# ─────────────────────────────────────────────────────────────────────────────
# The first administrator's sign-in address
# ─────────────────────────────────────────────────────────────────────────────

# MUST BE SHAPED LIKE AN E-MAIL ADDRESS. Sign-in is by address, and anything
# else is silently rewritten to <value>@unset.invalid — which is a confusing way
# to discover you cannot log in as the name you chose.
#
# It is an identifier, not a mailbox: nothing is ever mailed to it and the
# domain need not exist or be yours.
INITIAL_ADMIN_USERNAME=admin@example.com


# ─────────────────────────────────────────────────────────────────────────────
# Image selection — PIN A VERSION for anything you intend to keep
# ─────────────────────────────────────────────────────────────────────────────

# Defaults to :latest, which is right for a trial and wrong for an installation
# you maintain: an unattended `docker compose pull` then moves you across a
# release boundary at a time you did not choose.
#PQL_IMAGE=ghcr.io/postquantumleap/pql-app:3.4.1

# Mirroring internally? Point each of these at your own registry. They are
# separate variables rather than one prefix because Docker Hub images carry an
# implicit `library/` namespace that a naive prefix breaks.
#PQL_POSTGRES_IMAGE=registry.example.com/postgres:16
#PQL_CADDY_IMAGE=registry.example.com/caddy:2.11.4


# ─────────────────────────────────────────────────────────────────────────────
# TLS — see "Certificates" in the README
# ─────────────────────────────────────────────────────────────────────────────

# FIRST BOOT ONLY. With a domain set and no TLS configuration saved yet, the
# instance is born in ACME mode and the proxy orders a certificate on its own.
# It never overwrites an existing configuration — after first boot the TLS tab
# owns this setting. Leave empty to start with a self-signed certificate and
# choose in the UI.
#
# The name must already resolve to this host, or the ACME challenge fails.
#TLS_SEED_ACME_DOMAIN=pql.example.com
#TLS_SEED_ACME_EMAIL=tls-admin@example.com

# Order from Let's Encrypt's STAGING CA: untrusted certificates, but no rate
# limit. Do your first end-to-end run with this set to true — the production
# rate limit is low enough to lock you out for a week over a typo in the domain.
#TLS_SEED_ACME_STAGING=true

# Where the app writes uploaded and CSR-generated TLS material inside the
# container. The tls_certs volume mounts here. PRIVATE KEYS LIVE HERE AND NEVER
# IN THE DATABASE — a database backup is not a key backup.
#TLS_VOLUME_DIR=/var/lib/pql/tls


# ─────────────────────────────────────────────────────────────────────────────
# Scanning
# ─────────────────────────────────────────────────────────────────────────────

# Interval of the recurring background scan, in hours. The scan SCHEDULE (the
# time of day it runs) is set in the UI and carries its own timezone; this is
# only how often.
#SCAN_INTERVAL_HOURS=24

# IDS-safe throttling. Raise the gentleness if your scanning trips detection on
# the networks you point it at.
#SCAN_THROTTLING_MODE=Normal

# Targets scanned concurrently. Scans are network-bound, not CPU-bound, so this
# can exceed your core count comfortably.
#SCAN_CONCURRENCY=12


# ─────────────────────────────────────────────────────────────────────────────
# Remote engines — only if you scan networks this server cannot reach
# ─────────────────────────────────────────────────────────────────────────────

# How long an engine holds a claimed job before the watchdog returns it to the
# queue. The one worth raising is the TTL, and only when your engines routinely
# sit behind long change windows.
#REMOTE_ENGINE_LEASE_SECONDS=300
#REMOTE_ENGINE_JOB_TTL_SECONDS=3600
#REMOTE_ENGINE_WATCHDOG_SECONDS=60

# Fleet-wide rollback lever: un-advertise a bad engine build by setting these on
# the SERVER, effective at each engine's next check-in, with no engine-side
# involvement. Empty means "the build this server shipped with".
#ENGINE_VERSION=
#ENGINE_IMAGE_REF=
#ENGINE_IMAGE_DIGEST=


# ─────────────────────────────────────────────────────────────────────────────
# Networking — the defaults are correct for the shipped stack
# ─────────────────────────────────────────────────────────────────────────────

# The database owner password is reused for the least-privilege runtime role
# unless you set this. Setting it separates the two; the role's password is
# rotated to match on the next boot.
#APP_DB_PASSWORD=

# Leave TRUE. Set false ONLY to reach a local instance over plain HTTP from
# another device on your LAN — browsers refuse to store a Secure cookie over
# http://, so the login form otherwise bounces back with no error.
#
# NOT needed for http://localhost:8000, which is exempt regardless.
# Never set false where the instance is reachable from an untrusted network.
#HTTPS_ONLY=true

# Only for running the Vite dev server against this instance.
#CORS_ORIGINS=http://localhost:5173

# The address of the proxy the app trusts X-Forwarded-For from. The default is
# Caddy's static address on the compose network, and it is a /32 ON PURPOSE:
# trusting the whole bridge range would let anything reaching host loopback
# forge the client IP that the login rate limiter and account lockout key on.
# Change this only if you have moved the proxy.
#TRUSTED_PROXY_CIDRS=172.28.0.10/32

# Caddy's admin API, on the container network and never published to the host.
# SET IT EMPTY to run behind your own ingress instead: the TLS tab still
# renders, but every push becomes a recorded no-op. See "Bring your own
# ingress" in the README.
#PROXY_ADMIN_URL=http://caddy:2019


# ─────────────────────────────────────────────────────────────────────────────
# Support
# ─────────────────────────────────────────────────────────────────────────────

# Serves /docs, /redoc and /openapi.json. These are UNAUTHENTICATED by
# construction and publish the whole admin surface, so they are off by default.
# Turn on for a support session; turn off after.
#EXPOSE_API_DOCS=false


# ─────────────────────────────────────────────────────────────────────────────
# Passkeys — OFF until WEBAUTHN_RP_ID is set
# ─────────────────────────────────────────────────────────────────────────────

# Passkeys let people sign in with Touch ID, Windows Hello, a phone or a
# security key. There are TWO switches, and both start off:
#   1. here — WEBAUTHN_RP_ID makes passkeys AVAILABLE on this host;
#   2. in the console — a platform administrator picks the policy under
#      Platform → Settings → Passkeys, which stays "Off" until someone chooses.
#
# Passkeys need a DNS name and HTTPS. Browsers refuse them on an IP address, so
# an installation reached only by IP (https://192.168.1.20) leaves these empty
# and everyone signs in with a password; an IP address set here is ignored, with
# a warning at boot.
#
# After changing any of these run `docker compose up -d` — a plain restart keeps
# the old environment. Emptying WEBAUTHN_RP_ID again is the kill switch: every
# passkey screen disappears and nobody is required to use one. Nothing is deleted.

# The domain passkeys are bound to: the host name people type in the browser,
# with no scheme, port or path — e.g. pql.example.com, or an internal name such
# as pql.corp.example.com. Use a dotted name; a single label such as "intranet"
# is invalid, and an invalid value stops the server from starting.
#
# ⚠ CHOOSE IT ONCE. Every passkey is tied to this name: change it later, or move
# PQL to a different host name, and every enrolled passkey stops working. If you
# expect more names or a disaster-recovery site, use their common parent domain
# (example.com) BEFORE anyone enrols.
#WEBAUTHN_RP_ID=

# The browser address(es) a passkey sign-in may come from, comma-separated.
# Empty means https://<WEBAUTHN_RP_ID>, which is right for a standard install.
# Set it only when people reach PQL on another port or on a subdomain of the
# name above, e.g. https://pql.example.com:8443. Each entry is
# https://host[:port] on that name; http:// is accepted only for localhost.
#WEBAUTHN_ORIGINS=

# The name some authenticators show next to the account, e.g. in a phone's
# passkey list. 1–64 characters.
#WEBAUTHN_RP_NAME=Post Quantum Leap

# Trying passkeys on one machine: set WEBAUTHN_RP_ID=localhost and
# WEBAUTHN_ORIGINS=http://localhost:8000, then open http://localhost:8000 on the
# server itself (published on loopback only) — localhost, not 127.0.0.1.